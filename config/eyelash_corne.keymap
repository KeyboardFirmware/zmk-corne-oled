#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <400>;
};

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    bsp_del: bsp_del {
        compatible = "zmk,behavior-mod-morph";
        label = "BSP_DEL";
        bindings = <&kp BACKSPACE>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_RSFT)>;
    };

    combos {
        compatible = "zmk,combos";

        a {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <4 3>;
            layers = <0>;
        };

        b {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <9 8>;
            layers = <0>;
        };

        c {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        d {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
        };

        e {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <15 16>;
            layers = <0>;
        };

        f {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <24 25>;
            layers = <0>;
        };

        g {
            bindings = <&kp LESS_THAN>;
            key-positions = <2 3>;
            layers = <0>;
        };

        h {
            bindings = <&kp GREATER_THAN>;
            key-positions = <9 10>;
            layers = <0>;
        };

        i {
            bindings = <&soft_off>;
            key-positions = <5 44 7 45>;
            layers = <0>;
        };

        j {
            bindings = <&kp CAPSLOCK>;
            key-positions = <13 27>;
        };

        k {
            bindings = <&mo 4>;
            key-positions = <42 28>;
        };

        l {
            bindings = <&mo 4>;
            key-positions = <47 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "abc";
            bindings = <
&kp ESC    &kp Q       &kp W               &kp E           &kp R             &kp T                                 &msc SCRL_UP                     &kp Y        &kp U              &kp I            &kp O                &kp P                    &bsp_del
&kp TAB    &mt RGUI A  &mt LEFT_CONTROL S  &mt LEFT_ALT D  &mt LEFT_SHIFT F  &kp G                 &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &kp H        &mt RIGHT_SHIFT J  &mt RIGHT_ALT K  &mt RIGHT_CONTROL L  &mt K_CONTEXT_MENU SEMI  &kp SQT
&kp GRAVE  &kp Z       &kp X               &kp C           &kp V             &kp B        &none                    &msc SCRL_DOWN                   &kp N        &kp M              &kp COMMA        &kp DOT              &kp FSLH                 &kp BACKSLASH
                                           &mo 3           &mo 2             &lt 1 SPACE                                                            &lt 1 ENTER  &mo 2              &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        number {
            bindings = <
&trans  &kp PG_UP  &kp HOME  &kp UP    &kp END    &none                    &trans          &none   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none         &trans
&trans  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &none            &trans  &trans  &trans  &none   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0  &none
&none   &none      &none     &none     &none      &none   &none            &trans          &none   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none         &none
                             &trans    &trans     &trans                                   &trans  &trans        &trans
            >;

            label = "num";
        };

        symbol {
            bindings = <
&trans  &kp PG_UP  &kp HOME  &kp UP    &kp END    &none                    &trans          &none        &kp PLUS       &kp MINUS       &kp ASTERISK     &kp SLASH    &trans
&trans  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &none            &trans  &trans  &trans  &kp POUND    &kp EQUAL      &kp UNDERSCORE  &kp EXCLAMATION  &kp PERCENT  &none
&none   &none      &none     &none     &none      &none   &none            &trans          &kp AT_SIGN  &kp AMPERSAND  &kp PIPE        &kp CARET        &kp DOLLAR   &none
                             &trans    &trans     &trans                                   &trans       &trans         &trans
            >;

            label = "sym";
        };

        function {
            bindings = <
&trans  &kp PG_UP  &kp HOME  &kp UP    &kp END    &none                    &trans          &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &none            &trans  &trans  &trans  &trans  &kp F5  &kp F6   &kp F7   &kp F8   &none
&none   &none      &none     &none     &none      &none   &none            &trans          &trans  &kp F1  &kp F2   &kp F3   &kp F4   &none
                             &trans    &trans     &trans                                   &trans  &trans  &trans
            >;

            label = "fun";
        };

        admin {
            bindings = <
&bootloader  &none  &none  &none   &none           &bt BT_SEL 0                  &none         &rgb_ug RGB_BRI                 &none            &none   &none  &none  &bootloader
&none        &none  &none  &none   &none           &bt BT_SEL 1           &none  &none  &none  &rgb_ug RGB_BRD                 &none            &none   &none  &none  &none
&none        &none  &none  &none   &bt BT_CLR_ALL  &bt BT_SEL 2  &none           &none         &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_TOG  &none   &none  &none  &none
                           &trans  &trans          &trans                                      &trans                          &trans           &trans
            >;

            label = "adm";
        };
    };
};
