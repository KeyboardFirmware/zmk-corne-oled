#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <400>;
};

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    bsp_del: bsp_del {
        compatible = "zmk,behavior-mod-morph";
        label = "BSP_DEL";
        bindings = <&kp BACKSPACE>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_RSFT)>;
    };

    combos {
        compatible = "zmk,combos";

        a {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <4 3>;
            layers = <0>;
        };

        b {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <9 8>;
            layers = <0>;
        };

        c {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        d {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
        };

        e {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
            layers = <0>;
        };

        f {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <9 10>;
            layers = <0>;
        };

        g {
            bindings = <&kp LESS_THAN>;
            key-positions = <15 16>;
            layers = <0>;
        };

        h {
            bindings = <&kp GREATER_THAN>;
            key-positions = <25 24>;
            layers = <0>;
        };

        i {
            bindings = <&soft_off>;
            key-positions = <5 44 7 45>;
            layers = <0>;
        };

        j {
            bindings = <&kp CAPSLOCK>;
            key-positions = <42 47>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "abc";
            bindings = <
&kp ESC    &kp Q       &kp W               &kp E           &kp R             &kp T                                 &msc SCRL_UP                     &kp Y        &kp U              &kp I            &kp O                &kp P                    &bsp_del
&kp TAB    &mt RGUI A  &mt LEFT_CONTROL S  &mt LEFT_ALT D  &mt LEFT_SHIFT F  &kp G                 &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &kp H        &mt RIGHT_SHIFT J  &mt RIGHT_ALT K  &mt RIGHT_CONTROL L  &mt K_CONTEXT_MENU SEMI  &kp SQT
&kp GRAVE  &kp Z       &kp X               &kp C           &kp V             &kp B        &none                    &msc SCRL_DOWN                   &kp N        &kp M              &kp COMMA        &kp DOT              &kp FSLH                 &kp BACKSLASH
                                           &mo 3           &mo 2             &lt 1 SPACE                                                            &lt 1 ENTER  &mo 2              &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_1 {
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none                     &trans          &kp KP_NUMBER_0  &kp N1  &kp N2  &kp N3  &kp UNDERSCORE  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none             &trans  &trans  &trans  &kp KP_NUMBER_0  &kp N4  &kp N5  &kp N6  &kp EQUAL       &trans
&none   &kp F9  &kp F10  &kp F11  &kp F12  &none   &trans            &trans          &kp KP_NUMBER_0  &kp N7  &kp N8  &kp N9  &kp N0          &none
                         &trans   &trans   &trans                                    &trans           &trans  &trans
            >;

            label = "num";
        };

        layer_2 {
            bindings = <
&trans  &kp PAGE_UP      &kp HOME  &kp UP    &kp END    &none                     &trans          &none   &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp MINUS              &trans
&trans  &kp PAGE_DOWN    &kp LEFT  &kp DOWN  &kp RIGHT  &none             &trans  &trans  &trans  &none   &kp DOLLAR       &kp PERCENT   &kp CARET             &kp PLUS               &trans
&none   &kp PRINTSCREEN  &none     &none     &none      &none   &trans            &trans          &none   &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
                                   &trans    &trans     &trans                                    &trans  &trans           &trans
            >;

            label = "sym";
        };

        layer_3 {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans          &bt BT_SEL 0                    &trans          &rgb_ug RGB_BRI                 &trans           &trans  &trans  &trans  &bootloader
&trans       &trans  &trans  &trans  &trans          &bt BT_SEL 1            &trans  &trans  &trans  &rgb_ug RGB_BRD                 &trans           &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &bt BT_CLR_ALL  &bt BT_SEL 2  &trans            &trans          &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_TOG  &trans  &trans  &trans  &trans
                             &trans  &trans          &trans                                          &trans                          &trans           &trans
            >;

            label = "adm";
        };
    };
};
