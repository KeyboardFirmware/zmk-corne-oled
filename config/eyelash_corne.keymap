#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <400>;
};

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    bsp_del: bsp_del {
        compatible = "zmk,behavior-mod-morph";
        label = "BSP_DEL";
        bindings = <&kp BACKSPACE>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    combos {
        compatible = "zmk,combos";

        a {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <4 3>;
        };

        b {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <9 8>;
        };

        c {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        d {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
        };

        e {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <32 33>;
        };

        f {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <37 38>;
        };

        g {
            bindings = <&kp LESS_THAN>;
            key-positions = <14 15>;
        };

        h {
            bindings = <&kp GREATER_THAN>;
            key-positions = <26 25>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "qwerty";
            bindings = <
&kp ESC    &kp Q           &kp W               &kp E           &kp R             &kp T                           &kp UP                &kp Y        &kp U              &kp I            &kp O                &kp P                    &bsp_del
&kp TAB    &mt LEFT_GUI A  &mt LEFT_CONTROL S  &mt LEFT_ALT D  &mt LEFT_SHIFT F  &kp G                 &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &mt RIGHT_SHIFT J  &mt RIGHT_ALT K  &mt RIGHT_CONTROL L  &mt K_CONTEXT_MENU SEMI  &kp SQT
&kp GRAVE  &kp Z           &kp X               &kp C           &kp V             &kp B        &none              &kp DOWN              &kp N        &kp M              &kp COMMA        &kp DOT              &kp FSLH                 &kp BACKSLASH
                                               &mo 3           &mo 2             &lt 1 SPACE                                           &lt 1 ENTER  &mo 2              &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_1 {
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans                    &trans          &trans  &kp N7  &kp N8  &kp N9  &kp N0     &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans            &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &kp MINUS  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans            &trans          &trans  &kp N1  &kp N2  &kp N3  &kp EQUAL  &trans
                         &trans   &trans   &trans                                    &trans  &trans  &trans
            >;

            label = "num";
        };

        layer_2 {
            bindings = <
&trans  &kp PAGE_UP    &kp HOME  &kp UP    &kp END    &trans                    &trans          &kp AT_SIGN  &kp EXCLAMATION  &kp UNDERSCORE  &kp EQUAL   &kp PERCENT   &trans
&trans  &kp PAGE_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans            &trans  &trans  &trans  &kp HASH     &kp AMPERSAND    &kp MINUS       &kp PLUS    &kp ASTERISK  &kp SQT
&trans  &trans         &trans    &trans    &trans     &trans  &trans            &trans          &kp DOLLAR   &kp PIPE         &kp COMMA       &kp PERIOD  &kp SLASH     &trans
                                 &trans    &trans     &trans                                    &trans       &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans          &bt BT_SEL 0                    &trans          &rgb_ug RGB_BRI                 &trans           &trans  &trans  &trans  &bootloader
&trans       &trans  &trans  &trans  &trans          &bt BT_SEL 1            &trans  &trans  &trans  &rgb_ug RGB_BRD                 &trans           &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &bt BT_CLR_ALL  &bt BT_SEL 2  &trans            &trans          &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_TOG  &trans  &trans  &trans  &trans
                             &trans  &trans          &trans                                          &trans                          &trans           &trans
            >;
        };
    };
};
