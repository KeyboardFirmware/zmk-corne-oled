#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
    quick-tap-ms = <250>;
};

&lt {
    quick-tap-ms = <250>;
    tapping-term-ms = <300>;
};

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    bsp_del: bsp_del {
        compatible = "zmk,behavior-mod-morph";
        label = "BSP_DEL";
        bindings = <&kp BACKSPACE>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_RSFT|MOD_LSFT)>;
    };

    o_paren: o_paren {
        compatible = "zmk,behavior-mod-morph";
        label = "O_PAREN";
        bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    curly: curly {
        compatible = "zmk,behavior-mod-morph";
        label = "CURLY";
        bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    square: square {
        compatible = "zmk,behavior-mod-morph";
        label = "SQUARE";
        bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    c_paren: c_paren {
        compatible = "zmk,behavior-mod-morph";
        label = "C_PAREN";
        bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    and_or: and_or {
        compatible = "zmk,behavior-mod-morph";
        label = "AND_OR";
        bindings = <&kp AMPERSAND>, <&kp PIPE>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    regex: regex {
        compatible = "zmk,behavior-mod-morph";
        label = "REGEX";
        bindings = <&kp CARET>, <&kp DOLLAR>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    plus_minus: plus_minus {
        compatible = "zmk,behavior-mod-morph";
        label = "PLUS_MINUS";
        bindings = <&kp PLUS>, <&kp MINUS>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mult_div: mult_div {
        compatible = "zmk,behavior-mod-morph";
        label = "MULT_DIV";
        bindings = <&kp ASTERISK>, <&kp SLASH>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    hash_at: hash_at {
        compatible = "zmk,behavior-mod-morph";
        label = "HASH_AT";
        bindings = <&kp HASH>, <&kp AT_SIGN>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    bf_slash: bf_slash {
        compatible = "zmk,behavior-mod-morph";
        label = "BF_SLASH";
        bindings = <&kp BACKSLASH>, <&kp SLASH>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    equal_hot: equal_hot {
        compatible = "zmk,behavior-mod-morph";
        label = "EQUAL_HOT";
        bindings = <&kp EQUAL>, <&kp EXCLAMATION>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    under_percent: under_percent {
        compatible = "zmk,behavior-mod-morph";
        label = "UNDER_PERCENT";
        bindings = <&kp UNDERSCORE>, <&kp PERCENT>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    combos {
        compatible = "zmk,combos";

        b {
            bindings = <&kp CAPS>;
            key-positions = <13 27>;
        };

        op {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
            layers = <1>;
        };

        cp {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
            layers = <1>;
        };

        oa {
            bindings = <&kp LESS_THAN>;
            key-positions = <15 16>;
            layers = <1>;
        };

        ca {
            bindings = <&kp GREATER_THAN>;
            key-positions = <24 25>;
            layers = <1>;
        };

        os {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
            layers = <1>;
        };

        cs {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <9 10>;
            layers = <1>;
        };

        oc {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <3 4>;
            layers = <1>;
        };

        cc {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <8 9>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "abc";
            bindings = <
&kp ESC         &kp Q  &kp W               &kp E           &kp R      &kp T                                 &msc SCRL_UP                     &kp Y        &kp U      &kp I                 &kp O                &kp P          &kp BACKSPACE
&kp LEFT_SHIFT  &kp A  &mt LEFT_CONTROL S  &mt LEFT_ALT D  &kp F      &kp G                 &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &kp H        &kp J      &mt RIGHT_ALT K       &mt RIGHT_CONTROL L  &kp SEMICOLON  &kp RIGHT_SHIFT
&kp GRAVE       &kp Z  &kp X               &kp C           &kp V      &kp B        &none                    &msc SCRL_DOWN                   &kp N        &kp M      &kp COMMA             &kp DOT              &kp FSLH       &kp SQT
                                           &lt 3 LEFT_GUI  &lt 2 TAB  &lt 1 SPACE                                                            &lt 1 ENTER  &lt 2 DEL  &lt 3 K_CONTEXT_MENU
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        navigation_symbol {
            bindings = <
&trans  &kp PAGE_UP      &kp HOME  &kp UP     &kp END    &none                    &trans          &kp CARET      &kp DOLLAR  &kp AT_SIGN     &kp HASH         &kp BACKSLASH  &trans
&trans  &kp PAGE_DOWN    &kp LEFT  &kp DOWN   &kp RIGHT  &none            &trans  &trans  &trans  &kp AMPERSAND  &kp EQUAL   &kp UNDERSCORE  &kp EXCLAMATION  &kp PERCENT    &trans
&trans  &kp PRINTSCREEN  &none     &none      &none      &none   &none            &trans          &kp PIPE       &kp PLUS    &kp MINUS       &kp ASTERISK     &kp SLASH      &trans
                                   &kp LCTRL  &kp LALT   &trans                                   &trans         &kp RALT    &kp RCTRL
            >;

            label = "sym";
        };

        number_func {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3     &kp N4  &kp N5                     &trans          &none     &kp F1  &kp F2     &kp F3   &kp F4   &trans
&trans  &kp N6  &kp N7  &kp N8     &kp N9  &kp N0             &trans  &trans  &trans  &none     &kp F5  &kp F6     &kp F7   &kp F8   &trans
&trans  &none   &none   &none      &none   &none     &none            &trans          &none     &kp F9  &kp F10    &kp F11  &kp F12  &trans
                        &kp LCTRL  &trans  &kp LALT                                   &kp RALT  &trans  &kp RCTRL
            >;

            label = "num";
        };

        admin {
            bindings = <
&bootloader  &none  &none  &none   &none           &bt BT_SEL 0                  &none         &rgb_ug RGB_BRI                 &none            &none   &none  &none  &bootloader
&none        &none  &none  &none   &none           &bt BT_SEL 1           &none  &none  &none  &rgb_ug RGB_BRD                 &none            &none   &none  &none  &none
&none        &none  &none  &none   &bt BT_CLR_ALL  &bt BT_SEL 2  &none           &none         &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_TOG  &none   &none  &none  &none
                           &trans  &trans          &trans                                      &trans                          &trans           &trans
            >;

            label = "adm";
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans  &trans
            >;
        };
    };
};
