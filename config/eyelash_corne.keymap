#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
    quick-tap-ms = <250>;
};

&lt {
    quick-tap-ms = <250>;
    tapping-term-ms = <300>;
};

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    parenthesis: parenthesis {
        compatible = "zmk,behavior-mod-morph";
        label = "PARENTHESIS";
        bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    curly: curly {
        compatible = "zmk,behavior-mod-morph";
        label = "CURLY";
        bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    square: square {
        compatible = "zmk,behavior-mod-morph";
        label = "SQUARE";
        bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    angle: angle {
        compatible = "zmk,behavior-mod-morph";
        label = "ANGLE";
        bindings = <&kp LESS_THAN>, <&kp GREATER_THAN>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    and_or: and_or {
        compatible = "zmk,behavior-mod-morph";
        label = "AND_OR";
        bindings = <&kp AMPERSAND>, <&kp PIPE>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    regex: regex {
        compatible = "zmk,behavior-mod-morph";
        label = "REGEX";
        bindings = <&kp CARET>, <&kp DOLLAR>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    plus_minus: plus_minus {
        compatible = "zmk,behavior-mod-morph";
        label = "PLUS_MINUS";
        bindings = <&kp PLUS>, <&kp MINUS>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mult_div: mult_div {
        compatible = "zmk,behavior-mod-morph";
        label = "MULT_DIV";
        bindings = <&kp ASTERISK>, <&kp SLASH>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    hash_at: hash_at {
        compatible = "zmk,behavior-mod-morph";
        label = "HASH_AT";
        bindings = <&kp HASH>, <&kp AT_SIGN>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    bf_slash: bf_slash {
        compatible = "zmk,behavior-mod-morph";
        label = "BF_SLASH";
        bindings = <&kp BACKSLASH>, <&kp SLASH>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    equal_hot: equal_hot {
        compatible = "zmk,behavior-mod-morph";
        label = "EQUAL_HOT";
        bindings = <&kp EQUAL>, <&kp EXCLAMATION>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    under_percent: under_percent {
        compatible = "zmk,behavior-mod-morph";
        label = "UNDER_PERCENT";
        bindings = <&kp UNDERSCORE>, <&kp PERCENT>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    bsp_del: bsp_del {
        compatible = "zmk,behavior-tap-dance";
        label = "BSP_DEL";
        #binding-cells = <0>;
        bindings = <&kp BACKSPACE>, <&kp DEL>;
    };

    combos {
        compatible = "zmk,combos";

        b {
            bindings = <&kp CAPS>;
            key-positions = <28 41>;
        };

        up {
            bindings = <&kp UP>;
            key-positions = <2 3 4>;
        };

        down {
            bindings = <&kp DOWN>;
            key-positions = <15 16 17>;
        };

        left {
            bindings = <&kp LEFT>;
            key-positions = <15 16>;
        };

        right {
            bindings = <&kp RIGHT>;
            key-positions = <16 17>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <2 3>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <3 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "abc";
            bindings = <
&kp ESC           &kp Q  &kp W               &kp E           &kp R             &kp T                                 &msc SCRL_UP                     &kp Y        &kp U              &kp I            &kp O                &kp P          &kp BACKSPACE
&mt LEFT_GUI TAB  &kp A  &mt LEFT_CONTROL S  &mt LEFT_ALT D  &mt LEFT_SHIFT F  &kp G                 &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &kp H        &mt RIGHT_SHIFT J  &mt RIGHT_ALT K  &mt RIGHT_CONTROL L  &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT    &kp Z  &kp X               &kp C           &kp V             &kp B        &none                    &msc SCRL_DOWN                   &kp N        &kp M              &kp COMMA        &kp DOT              &kp FSLH       &kp RIGHT_SHIFT
                                             &mo 3           &mo 2             &lt 1 SPACE                                                            &lt 1 ENTER  &mo 2              &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        number_function {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                     &trans          &kp N6   &kp N7  &kp N8  &kp N9  &kp N0   &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5             &trans  &trans  &trans  &kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &trans  &trans  &trans  &trans  &kp F11  &trans            &trans          &kp F12  &trans  &trans  &trans  &trans   &trans
                        &trans  &trans  &trans                                     &trans   &trans  &trans
            >;

            label = "num";
        };

        symbol {
            bindings = <
&trans  &kp TILDE      &kp AT_SIGN      &kp AMPERSAND  &kp CARET       &kp LEFT_BRACE                          &trans          &kp RIGHT_BRACE        &kp DOLLAR  &kp PIPE   &kp POUND     &kp DOUBLE_QUOTES  &trans
&trans  &kp GRAVE      &kp EXCLAMATION  &kp EQUAL      &kp UNDERSCORE  &kp LEFT_PARENTHESIS            &trans  &trans  &trans  &kp RIGHT_PARENTHESIS  &kp PLUS    &kp MINUS  &kp ASTERISK  &kp SQT            &trans
&trans  &kp BACKSLASH  &none            &none          &none           &kp LEFT_BRACKET      &trans            &trans          &kp RIGHT_BRACKET      &none       &none      &none         &kp PERCENT        &trans
                                        &trans         &trans          &trans                                                  &trans                 &trans      &trans
            >;

            label = "sym";
        };

        admin {
            bindings = <
&bootloader  &sys_reset  &none  &none   &none           &bt BT_SEL 0                  &none         &rgb_ug RGB_BRI                 &none            &none   &none  &sys_reset  &bootloader
&none        &none       &none  &none   &none           &bt BT_SEL 1           &none  &none  &none  &rgb_ug RGB_BRD                 &none            &none   &none  &none       &none
&none        &none       &none  &none   &bt BT_CLR_ALL  &bt BT_SEL 2  &none           &none         &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_TOG  &none   &none  &none       &none
                                &trans  &trans          &trans                                      &trans                          &trans           &trans
            >;

            label = "adm";
        };
    };
};
