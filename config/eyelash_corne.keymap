#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
    quick-tap-ms = <250>;
};

&lt {
    quick-tap-ms = <250>;
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        b {
            bindings = <&kp CAPS>;
            key-positions = <13 27>;
        };

        op {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
            layers = <1>;
        };

        cp {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
            layers = <1>;
        };

        oa {
            bindings = <&kp LESS_THAN>;
            key-positions = <15 16>;
            layers = <1>;
        };

        ca {
            bindings = <&kp GREATER_THAN>;
            key-positions = <24 25>;
            layers = <1>;
        };

        os {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
            layers = <1>;
        };

        cs {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <9 10>;
            layers = <1>;
        };

        oc {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <3 4>;
            layers = <1>;
        };

        cc {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <8 9>;
            layers = <1>;
        };

        admin {
            bindings = <&mo 4>;
            key-positions = <42 47>;
        };
    };

    macros {
        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>;
            label = "CUT";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>;
            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
            label = "PASTE";
        };

        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>;
            label = "UNDO";
        };

        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Y)>;
            label = "REDO";
        };

        sel_fwd: sel_fwd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(RIGHT) &kp LS(LC(LEFT))>;
            label = "SEL_FWD";
        };

        sel_back: sel_back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT) &kp LS(LC(RIGHT))>;
            label = "SEL_BACK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "abc";
            bindings = <
&kp ESC         &kp Q  &kp W               &kp E           &kp R           &kp T                                 &msc SCRL_UP                     &kp Y        &kp U                 &kp I            &kp O                &kp P          &kp BACKSPACE
&kp TAB         &kp A  &mt LEFT_CONTROL S  &mt LEFT_ALT D  &kp F           &kp G                 &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &kp H        &kp J                 &mt RIGHT_ALT K  &mt RIGHT_CONTROL L  &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X               &kp C           &kp V           &kp B        &none                    &msc SCRL_DOWN                   &kp N        &kp M                 &kp COMMA        &kp DOT              &kp FSLH       &kp RIGHT_SHIFT
                                           &mo 3           &lt 2 LEFT_GUI  &lt 1 SPACE                                                            &lt 1 ENTER  &lt 2 K_CONTEXT_MENU  &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        navigation_symbol {
            bindings = <
&kp GRAVE  &kp PAGE_UP    &kp HOME  &kp UP     &kp END    &sel_fwd                    &trans          &kp AT_SIGN      &kp CARET      &kp DOLLAR      &kp PERCENT   &kp BACKSLASH  &trans
&trans     &kp PAGE_DOWN  &kp LEFT  &kp DOWN   &kp RIGHT  &sel_back           &trans  &trans  &trans  &kp EXCLAMATION  &kp EQUAL      &kp UNDERSCORE  &kp PLUS      &kp MINUS      &trans
&trans     &undo          &cut      &copy      &paste     &redo      &none            &trans          &kp HASH         &kp AMPERSAND  &kp PIPE        &kp ASTERISK  &kp SLASH      &trans
                                    &kp LCTRL  &kp LALT   &trans                                      &trans           &kp RALT       &kp RCTRL
            >;

            label = "sym";
        };

        number_func {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3     &kp N4  &kp N5                     &trans          &none     &kp F1  &kp F2     &kp F3   &kp F4   &trans
&trans  &kp N6  &kp N7  &kp N8     &kp N9  &kp N0             &trans  &trans  &trans  &none     &kp F5  &kp F6     &kp F7   &kp F8   &trans
&trans  &none   &none   &none      &none   &none     &none            &trans          &none     &kp F9  &kp F10    &kp F11  &kp F12  &trans
                        &kp LCTRL  &trans  &kp LALT                                   &kp RALT  &trans  &kp RCTRL
            >;

            label = "num";
        };

        extra {
            bindings = <
&none  &none  &none  &none   &none             &none                         &none         &none          &none              &none   &none  &none  &none
&none  &none  &none  &none   &none             &none                  &none  &none  &none  &none          &none              &none   &none  &none  &none
&none  &none  &none  &none   &none             &none         &none           &none         &none          &none              &none   &none  &none  &none
                     &trans  &kp LEFT_CONTROL  &kp LEFT_ALT                                &kp RIGHT_ALT  &kp RIGHT_CONTROL  &trans
            >;

            label = "xtr";
        };

        admin {
            bindings = <
&bootloader  &none  &none  &none   &none           &bt BT_SEL 0                  &none         &rgb_ug RGB_BRI                 &none            &none   &none  &none  &bootloader
&none        &none  &none  &none   &none           &bt BT_SEL 1           &none  &none  &none  &rgb_ug RGB_BRD                 &none            &none   &none  &none  &none
&none        &none  &none  &none   &bt BT_CLR_ALL  &bt BT_SEL 2  &none           &none         &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_TOG  &none   &none  &none  &none
                           &trans  &trans          &trans                                      &trans                          &trans           &trans
            >;

            label = "adm";
        };
    };
};
