#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
    quick-tap-ms = <250>;
};

&lt {
    quick-tap-ms = <250>;
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        b {
            bindings = <&kp CAPS>;
            key-positions = <28 41>;
        };

        op {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
            layers = <1>;
        };

        cp {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
            layers = <1>;
        };

        oa {
            bindings = <&kp LESS_THAN>;
            key-positions = <15 16>;
            layers = <1>;
        };

        ca {
            bindings = <&kp GREATER_THAN>;
            key-positions = <24 25>;
            layers = <1>;
        };

        os {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
            layers = <1>;
        };

        cs {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <9 10>;
            layers = <1>;
        };

        oc {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <3 4>;
            layers = <1>;
        };

        cc {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <8 9>;
            layers = <1>;
        };

        admin {
            bindings = <&mo 3>;
            key-positions = <44 45>;
        };
    };

    macros {
        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>;
            label = "CUT";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>;
            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
            label = "PASTE";
        };

        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>;
            label = "UNDO";
        };

        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Y)>;
            label = "REDO";
        };

        select: sel_fwd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(RIGHT) &kp LS(LC(LEFT))>;
            label = "SEL_FWD";
        };
    };

    behaviors {
        back_del: back_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BACK_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "abc";
            bindings = <
&kp ESC         &kp Q  &kp W  &kp E             &kp R         &kp T                        &to 0         &kp Y        &kp U          &kp I              &kp O    &kp P          &back_del
&kp TAB         &kp A  &kp S  &kp D             &kp F         &kp G                 &to 1  &to 4  &to 3  &kp H        &kp J          &kp K              &kp L    &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C             &kp V         &kp B        &none           &to 2         &kp N        &kp M          &kp COMMA          &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
                              &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 1 SPACE                                &lt 2 ENTER  &kp RIGHT_ALT  &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        navigation_symbol {
            bindings = <
&trans  &kp PAGE_UP    &kp HOME  &kp UP            &kp END       &select                       &trans          &none        &none          &none              &none  &none  &trans
&trans  &kp PAGE_DOWN  &kp LEFT  &kp DOWN          &kp RIGHT     &none                 &trans  &trans  &trans  &none        &none          &none              &none  &none  &none
&trans  &undo          &cut      &copy             &paste        &redo        &none            &trans          &none        &none          &none              &none  &none  &trans
                                 &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 1 SPACE                                   &lt 2 ENTER  &kp RIGHT_ALT  &kp RIGHT_CONTROL
            >;

            label = "sym";
        };

        number {
            bindings = <
&trans  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &trans          &kp N6          &kp N7    &kp N8     &kp N9             &kp N0     &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp POUND         &kp DOLLAR            &kp PERCENT                    &trans  &trans  &trans  &kp N1          &kp N2    &kp N3     &kp N4             &kp N5     &none
&trans  &kp BACKSLASH    &kp PIPE      &kp GRAVE         &kp TILDE             &kp EQUAL              &none           &trans          &kp UNDERSCORE  &kp PLUS  &kp MINUS  &kp ASTERISK       &kp SLASH  &trans
                                       &kp LEFT_CONTROL  &kp LEFT_ALT          &lt 1 SPACE                                            &lt 2 ENTER     &kp RIGHT_ALT        &kp RIGHT_CONTROL
            >;

            label = "num";
        };

        function {
            bindings = <
&trans  &none  &none  &none             &none         &none                         &trans          &none       &kp F9         &kp F10            &kp F11  &kp F12  &trans
&trans  &none  &none  &none             &none         &none                 &trans  &trans  &trans  &none       &kp F5         &kp F6             &kp F7   &kp F8   &none
&trans  &none  &none  &none             &none         &none        &trans           &trans          &none       &kp F1         &kp F2             &kp F3   &kp F4   &trans
                      &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 1 SPACE                                  &lt 2 ENTER  &kp RIGHT_ALT  &kp RIGHT_CONTROL
            >;

            label = "fun";
        };

        admin {
            bindings = <
&bootloader  &none  &none  &none             &none           &bt BT_SEL 0                   &trans          &rgb_ug RGB_BRI                 &none            &none              &none  &none  &bootloader
&none        &none  &none  &none             &none           &bt BT_SEL 1           &trans  &trans  &trans  &rgb_ug RGB_BRD                 &none            &none              &none  &none  &none
&none        &none  &none  &none             &bt BT_CLR_ALL  &bt BT_SEL 2  &none            &trans          &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_TOG  &none              &none  &none  &none
                           &kp LEFT_CONTROL  &kp LEFT_ALT    &lt 1 SPACE                                    &lt 2 ENTER                     &kp RIGHT_ALT    &kp RIGHT_CONTROL
            >;

            label = "adm";
        };
    };
};
