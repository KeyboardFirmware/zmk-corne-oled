#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <400>;
};

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    bsp_del: bsp_del {
        compatible = "zmk,behavior-mod-morph";
        label = "BSP_DEL";
        bindings = <&kp BACKSPACE>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_RSFT|MOD_LSFT)>;
    };

    combos {
        compatible = "zmk,combos";

        a {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <4 3>;
            layers = <0>;
        };

        b {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <9 8>;
            layers = <0>;
        };

        c {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        d {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <23 24>;
        };

        e {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <15 16>;
            layers = <0>;
        };

        f {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <24 25>;
            layers = <0>;
        };

        g {
            bindings = <&kp LESS_THAN>;
            key-positions = <2 3>;
            layers = <0>;
        };

        h {
            bindings = <&kp GREATER_THAN>;
            key-positions = <9 10>;
            layers = <0>;
        };

        i {
            bindings = <&mo 3>;
            key-positions = <44 45>;
            layers = <0>;
        };

        j {
            bindings = <&mo 4>;
            key-positions = <43 46>;
        };

        k {
            bindings = <&kp CAPS>;
            key-positions = <33 36>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "abc";
            bindings = <
&kp ESC             &kp Q  &kp W  &kp E             &kp R  &kp T                                 &msc SCRL_UP                     &kp Y        &kp U  &kp I          &kp O    &kp P          &bsp_del
&mt TAB LEFT_SHIFT  &kp A  &kp S  &kp D             &kp F  &kp G                 &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &kp H        &kp J  &kp K          &kp L    &kp SEMICOLON  &mt RIGHT_SHIFT SQT
&kp GRAVE           &kp Z  &kp X  &kp C             &kp V  &kp B        &none                    &msc SCRL_DOWN                   &kp N        &kp M  &kp COMMA      &kp DOT  &kp FSLH       &kp BACKSLASH
                                  &kp LEFT_CONTROL  &mo 2  &lt 1 SPACE                                                            &lt 1 ENTER  &mo 2  &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        navigation {
            bindings = <
&trans  &none  &kp HOME  &kp UP    &kp END    &none                    &trans          &none   &none   &none   &none  &none  &trans
&trans  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none            &trans  &trans  &trans  &none   &none   &none   &none  &none  &trans
&none   &none  &none     &none     &none      &none   &none            &trans          &none   &none   &none   &none  &none  &none
                         &trans    &trans     &trans                                   &trans  &trans  &trans
            >;

            label = "nav";
        };

        number {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                   &trans          &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans  &none         &none         &none         &none         &kp MINUS              &trans  &trans  &trans  &kp EQUAL     &none         &none         &none         &none         &trans
&none   &none         &none         &none         &none         &none         &none            &trans          &none         &none         &none         &none         &none         &none
                                    &trans        &trans        &trans                                         &trans        &trans        &trans
            >;

            label = "num";
        };

        function {
            bindings = <
&trans  &kp F1  &kp F1  &kp F3  &kp F4  &kp F5                    &trans          &kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &none   &none   &none   &none   &kp F11           &trans  &trans  &trans  &kp F12  &none   &none   &none   &none    &trans
&none   &none   &none   &none   &none   &none    &none            &trans          &trans   &none   &none   &none   &none    &none
                        &trans  &trans  &trans                                    &trans   &trans  &trans
            >;

            label = "fun";
        };

        admin {
            bindings = <
&bootloader  &none  &none  &none   &none           &bt BT_SEL 0                  &none         &rgb_ug RGB_BRI                 &none            &none   &none  &none  &bootloader
&none        &none  &none  &none   &none           &bt BT_SEL 1           &none  &none  &none  &rgb_ug RGB_BRD                 &none            &none   &none  &none  &none
&none        &none  &none  &none   &bt BT_CLR_ALL  &bt BT_SEL 2  &none           &none         &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_TOG  &none   &none  &none  &none
                           &trans  &trans          &trans                                      &trans                          &trans           &trans
            >;

            label = "adm";
        };
    };
};
